   "cell_type": "code",
   "execution_count": 293,
   "id": "22cfee02-5f10-44c5-9b5f-17c29045b590",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Separate features (X) and target (y)\n",
    "x = train_df.drop(columns=[\"revenue_category\", 'title']) # Drops target + title (not predictive)\n",
    "y = train_df[\"revenue_category\"].map({\"Low\": 0, \"High\": 1}) # Encode target into binary (0 = Low, 1 = High)\n",
    "x_train, x_val, y_train, y_val = train_test_split(x, y, test_size=0.2, stratify=y, random_state=42) # Split data into train + validation"
   ]
