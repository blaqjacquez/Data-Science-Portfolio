  {
   "cell_type": "code",
   "execution_count": 295,
   "id": "8950298b-5eb2-4ad5-8b9c-df7c262ecd0e",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Seperate features by type for preprocessing\n",
    "\n",
    "# This explicitly lists categorical features to be one-hot encoded\n",
    "categorical_features = [\"country\", \"language\", \"censor_rating\"]\n",
    "# Automatically detects all numerical features, whether int or float\n",
    "numerical_features = x_train.select_dtypes(include=[np.number]).columns.tolist()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "52d43da5-17bb-4505-90bd-f371b20ac245",
   "metadata": {},
   "source": [
    "### SECTION FIVE: BUILDING PREPROCESSING PIPELINES"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 298,
   "id": "fbdce40d-934a-4077-b352-c88ea5e59508",
   "metadata": {},
   "outputs": [],
   "source": [
    "# For numeric preprocessing, scale values so models aren't biased by feature magnitude\n",
    "numeric_transformer = Pipeline(steps=[\n",
    "    (\"scaler\", StandardScaler()) # standardize numerical features\n",
    "])\n",
    "\n",
    "# For categorical preprocessing, encode categories into numerical one-hot vectors\n",
    "categorical_transformer = Pipeline(steps=[\n",
    "    (\"encoded\", OneHotEncoder(handle_unknown=\"ignore\")) # OneHotEncoder turns categories into binary features\n",
    "])\n",
    "\n",
    "# Finally, combine both pipelines into a single preprocessor\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        (\"num\", numeric_transformer, numerical_features),\n",
    "        (\"cat\", categorical_transformer, categorical_features)\n",
    "    ]\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 300,
   "id": "ae44f5c5-24e5-495f-ad42-ed8169a635df",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Combine preprocessing and model into one pipeline\n",
    "clf = Pipeline(steps=[\n",
    "               (\"preprocessor\", preprocessor),\n",
    "               (\"model\", LogisticRegression(max_iter=1000, random_state=42))\n",
    "])\n",
    "\n",
    "# Fit pipeline on training data\n",
    "clf.fit(x_train, y_train)\n",
    "# Get predictions on validation set\n",
    "preds = clf.predict(x_val)"
   ]
